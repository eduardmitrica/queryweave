impl ::queryweave_sql::AppendToQuery for OrdersQueryModelWrapper {
    fn append_to_query<Q, F>(&self, query: &mut Q, privileged_guard_option: Option<F>)
    where
        Q: ::queryweave_sql::ConditionsTarget + ::queryweave_sql::OrderByTarget
            + ::queryweave_sql::PageTarget,
        F: FnOnce(&mut Q, &Self),
    {
        fn start_building_where_clause_if_has_options<
            Q: ::queryweave_sql::ConditionsTarget,
        >(query: &mut Q, inner: &OrdersQueryModel) {
            if inner.and.has_options() {
                ::queryweave_sql::ConditionsTarget::write_where(query);
                let wrapper = OrdersFilterOptionsModelWrapper(inner.and.clone());
                ::queryweave_sql::AppendToQueryWithSeparator::append_to_query(
                    &wrapper,
                    query,
                    "AND",
                );
            }
        }
        fn build_clauses_after_where_clause<
            Q: ::queryweave_sql::OrderByTarget + ::queryweave_sql::PageTarget,
        >(query: &mut Q, inner: &OrdersQueryModel) {
            <crate::entities::order::Order as ::queryweave_sql::Columns>::push_order_by(
                query,
                inner.sort_keys(),
            );
            ::queryweave_sql::push_page(query, inner.page, inner.page_size);
        }
        start_building_where_clause_if_has_options(query, &self.0);
        if let Some(function) = privileged_guard_option {
            function(query, &self);
        }
        build_clauses_after_where_clause(query, &self.0);
    }
}
