impl ::queryweave_sql::AppendToQuery for OrdersQueryModelWrapper {
    fn append_to_query<DB, F>(
        &self,
        query_builder: &mut ::queryweave_sql::QueryBuilder<'_, DB>,
        privileged_guard_option: Option<F>,
    )
    where
        DB: ::queryweave_sql::BindValues,
        F: FnOnce(&mut ::queryweave_sql::QueryBuilder<'_, DB>, &Self),
    {
        fn start_building_where_clause_if_has_options<DB: ::queryweave_sql::BindValues>(
            query_builder: &mut ::queryweave_sql::QueryBuilder<'_, DB>,
            query: &OrdersQueryModel,
        ) {
            if query.and.has_options() {
                query_builder.push("WHERE ");
                let wrapper = OrdersFilterOptionsModelWrapper(query.and.clone());
                ::queryweave_sql::AppendToQueryWithSeparator::append_to_query(
                    &wrapper,
                    query_builder,
                    "AND",
                );
            }
        }
        fn build_clauses_after_where_clause<DB: ::queryweave_sql::BindValues>(
            query_builder: &mut ::queryweave_sql::QueryBuilder<'_, DB>,
            query: &OrdersQueryModel,
        ) {
            <crate::entities::order::Order as ::queryweave_sql::Columns>::push_order_by(
                query_builder,
                query.sort_keys(),
            );
            ::queryweave_sql::push_page(query_builder, query.page, query.page_size);
        }
        start_building_where_clause_if_has_options(query_builder, &self.0);
        if let Some(function) = privileged_guard_option {
            function(query_builder, &self);
        }
        build_clauses_after_where_clause(query_builder, &self.0);
    }
}
