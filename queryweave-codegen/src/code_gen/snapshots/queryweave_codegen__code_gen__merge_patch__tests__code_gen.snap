impl ::queryweave::ChangedFields for OrderModel {
    /// Iterate through all fields, excluding fields marked as #[merge_patch(skip)]
    /// and return a change set (a hash-set consisting of the field names
    /// of the fields that were changed).
    fn modified_fields(&self, previous: &Self) -> ::queryweave::ChangeSet {
        let mut fields_that_were_changed = ::queryweave::ChangeSet::default();
        if self.client != previous.client {
            _ = fields_that_were_changed.insert("client");
        }
        if self.capacity != previous.capacity {
            _ = fields_that_were_changed.insert("capacity");
        }
        fields_that_were_changed
    }
}
