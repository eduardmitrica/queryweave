impl OrderModel {
    /// Merge a model with a patch resulting in a modified model.
    pub fn merge(&mut self, merge_patch: MergePatchOrderModel) {
        ::queryweave::PatchField::apply_to(merge_patch.client, &mut self.client);
        ::queryweave::PatchField::apply_to(merge_patch.capacity, &mut self.capacity);
    }
    /// The changed fields (per `diff`, see `ChangedFields::modified_fields`)
    /// with their current raw values, as database-agnostic field/value
    /// pairs for the persistence layer to write.
    #[must_use]
    pub fn changed_values(
        &self,
        diff: &::queryweave::ChangeSet,
    ) -> ::queryweave::FieldValues<Self> {
        ::queryweave::__private::model_data({
            let mut values = Vec::new();
            if diff.contains("client") {
                values
                    .push(::queryweave::FieldValue {
                        field: "client",
                        value: ::queryweave::IntoValue::into_value(
                            ::queryweave::RawValue::to_raw(&self.client),
                        ),
                    });
            }
            if diff.contains("capacity") {
                values
                    .push(::queryweave::FieldValue {
                        field: "capacity",
                        value: ::queryweave::IntoValue::into_value(
                            ::queryweave::RawValue::to_raw(&self.capacity),
                        ),
                    });
            }
            values
        })
    }
