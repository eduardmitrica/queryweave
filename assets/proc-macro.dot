// The pipeline every derive runs (`queryweave_codegen::steps::expand`).
// Render with: dot -Tpng -Gdpi=110 assets/proc-macro.dot -o assets/proc-macro.png
digraph proc_macro {
    graph [
        rankdir = LR,
        fontname = "Helvetica",
        fontsize = 14,
        nodesep = 0.5,
        ranksep = 0.55,
        newrank = true,
        compound = true,
        bgcolor = "white",
        pad = 0.3,
    ];
    node [
        fontname = "Helvetica",
        fontsize = 12,
        shape = box,
        style = "filled",
        fillcolor = "white",
        color = "black",
        width = 1.7,
        height = 0.6,
    ];
    edge [fontname = "Helvetica", fontsize = 10, color = "black", fontcolor = "#333333"];

    input [label = "Input", shape = plaintext, fillcolor = "none", fontsize = 14, fontname = "Helvetica-Bold"];
    output [label = "Output", shape = plaintext, fillcolor = "none", fontsize = 14, fontname = "Helvetica-Bold"];

    subgraph cluster_expand {
        label = <<b>queryweave-codegen</b>: <font face="Courier">expand::&lt;D: Derive&gt;</font><br/><font point-size="11" color="#c0392b">the errors of every stage that ran come out as compile_error!(...)</font>>;
        fontsize = 18;
        style = dashed;
        color = "black";
        margin = 18;

        subgraph cluster_step1 {
            label = "1. side by side, errors reported together";
            labelloc = b;
            fontsize = 11;
            fontcolor = "#555555";
            style = "rounded,dotted";
            color = "#888888";

            meta [label = "parse top level meta\n(TopLevelMeta)", fillcolor = "#d5e8d4", color = "#82b366"];
            parse [label = "parse\n(Parsed)"];
        }

        subgraph cluster_step2 {
            label = "2. side by side, errors reported together";
            labelloc = b;
            fontsize = 11;
            fontcolor = "#555555";
            style = "rounded,dotted";
            color = "#888888";

            mapping [label = "mapping\n(MappingPaths)", fillcolor = "#d5e8d4", color = "#82b366"];

            subgraph cluster_optional {
                label = "skipped by simple derives\n(identity types)";
                fontsize = 11;
                fontcolor = "#c0392b";
                style = dashed;
                color = "#e06666";

                analyze [label = "analyze?\n(Model)"];
            }
        }

        subgraph cluster_step3 {
            label = "3.";
            fontsize = 11;
            fontcolor = "#555555";
            style = invis;

            lower [label = "lower\n(IR)"];
        }

        subgraph cluster_step4 {
            label = "4.";
            fontsize = 11;
            fontcolor = "#555555";
            style = invis;

            code_gen [label = "code gen"];
        }
    }

    // Inputs.
    input -> meta [label = "struct attributes", color = "#82b366", fontcolor = "#82b366"];
    input -> parse [label = "Rust (DeriveInput)"];

    // Step 1 -> 2.
    meta -> mapping [label = "TopLevelMeta\n(the linked paths,\n#[queryweave(crate = ...)])", color = "#82b366", fontcolor = "#82b366"];
    parse -> mapping [label = "Parsed", color = "#82b366", fontcolor = "#82b366"];
    parse -> analyze [label = "Parsed"];

    // Step 2 -> 3 -> 4.
    analyze -> lower [label = "Model"];
    parse -> lower [label = "Parsed (idents, or the IR itself)", style = dashed];
    lower -> code_gen [label = "IR"];
    mapping -> code_gen [label = "MappingPaths\n(incl. the runtime crate)", color = "#82b366", fontcolor = "#82b366"];

    code_gen -> output [label = "Rust"];


    { rank = same; meta; parse; }
    { rank = same; mapping; analyze; }
}
